PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/PRISM_DB?retryWrites=true&w=majority
JWT_SECRET=change_me_in_real_environment

# Creates empty MongoDB collections and indexes when the API starts.
CREATE_COLLECTIONS=true

# Inserts initial admin user, products, specialties, and cycles.
SEED_DATABASE=false
DEFAULT_ADMIN_NAME=Admin Prism
DEFAULT_ADMIN_EMAIL=admin@prism.com
DEFAULT_ADMIN_PASSWORD=Prism2026!
